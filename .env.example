VITE_API_BASE_URL=http://localhost:8080/api

# SMTP provider (recommended for local development)
OTP_SMTP_HOST=smtp.gmail.com
OTP_SMTP_PORT=587
OTP_SMTP_USER=your-email@gmail.com
OTP_SMTP_PASS=your-gmail-app-password
OTP_MAIL_FROM=your-email@gmail.com
OTP_SMTP_SECURE=false

# Keep OTPs out of the command-line logs and API responses.
OTP_EXPOSE_IN_DEVELOPMENT=False

# Alternative providers: configure these instead of SMTP.
# RESEND_API_KEY=
# OTP_MAIL_FROM=onboarding@resend.dev
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=your-email@example.com

# Direct UPI QR Payment Configuration
RECEIVER_UPI_ID=your-upi-id@bank